package timer_pkg is

    type ssd_array is array (0 to 3) of bit_vector(6 downto 0);
    type bcd_array is array (0 to 3) of integer range 0 to 9;

    function bcd_to_ssds (bcd   : bcd_array) return ssd_array;
    function int_to_bcd  (value : integer)   return bcd_array;

end package timer_pkg;
-------------------------------------------------------------------------------

package body timer_pkg is

    function digit_to_7seg (d : integer range 0 to 9) return bit_vector is
    begin
        case d is
            when 0      => return "1000000";
            when 1      => return "1111001";
            when 2      => return "0100100";
            when 3      => return "0110000";
            when 4      => return "0011001";
            when 5      => return "0010010";
            when 6      => return "0000010";
            when 7      => return "1111000";
            when 8      => return "0000000";
            when 9      => return "0010000";
            when others => return "1111111";
        end case;
    end function digit_to_7seg;

    function bcd_to_ssds (bcd : bcd_array) return ssd_array is
        variable ssd : ssd_array;
    begin
        for i in 0 to 3 loop
            ssd(i) := digit_to_7seg(bcd(i));
        end loop;
        return ssd;
    end function bcd_to_ssds;

    function int_to_bcd (value : integer) return bcd_array is
        variable bcd : bcd_array;
        variable v   : integer := value;
    begin
        for i in 0 to 3 loop
            bcd(i) := v mod 10;
            v      := v  /  10;
        end loop;
        return bcd;
    end function int_to_bcd;

end package body timer_pkg;