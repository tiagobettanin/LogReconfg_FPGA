library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.timer_pkg.all;

entity atividade7 is
    generic (
        -- Frequencia do clock em Hz. Padrao = 50 MHz (DE10-Lite).
        -- Sobrescrever com um valor baixo (ex.: 10) para simulacao.
        CLK_FREQ : integer := 50_000_000
    );
    port (
        clk      : in  std_logic;                       -- clock principal
        reset_n  : in  std_logic;                       -- KEY[0]: reset assincrono (ativo em '0')
        pause_n  : in  std_logic;                       -- KEY[1]: pausa enquanto pressionado (ativo em '0')
        sel      : in  std_logic_vector(1 downto 0);   -- SW[1..0]: seleciona preset de tempo

        led_done : out std_logic;                       -- LEDR[0]: aceso quando o timer chega a 0
        hex0     : out std_logic_vector(6 downto 0);    -- HEX0: unidades
        hex1     : out std_logic_vector(6 downto 0);    -- HEX1: dezenas
        hex2     : out std_logic_vector(6 downto 0);    -- HEX2: centenas
        hex3     : out std_logic_vector(6 downto 0)     -- HEX3: milhares
    );
end entity atividade7;

-------------------------------------------------------------------------------
architecture atividade7_arch of atividade7 is

    -- Valor atual do contador, em segundos
    signal seconds  : integer range 0 to 9999;

    -- Pulso de 1 ciclo de clock a cada segundo (gerado pelo divisor de clock)
    signal tick_1hz : std_logic;

    -- Valor de preset selecionado pelas chaves
    signal preset   : integer range 0 to 9999;

    -- BCD do valor corrente (16 bits = 4 digitos)
    signal bcd_val  : std_logic_vector(15 downto 0);

    -- Sinal interno do tipo ssd_array (definido no package).
    -- Mesma estrategia da Atividade 6: usar o tipo do usuario internamente
    -- e atribuir aos pinos individuais na hora de mandar pra porta.
    signal ssd      : ssd_array;

begin

    -- -------------------------------------------------------------------------
    -- Selecao do preset de tempo conforme as chaves SW[1..0]
    -- -------------------------------------------------------------------------
    process(sel)
    begin
        case sel is
            when "00"   => preset <= 10;    -- 10 segundos
            when "01"   => preset <= 30;    -- 30 segundos
            when "10"   => preset <= 60;    -- 60 segundos (1 minuto)
            when others => preset <= 300;   -- 300 segundos (5 minutos)
        end case;
    end process;

    -- -------------------------------------------------------------------------
    -- Divisor de clock: gera 'tick_1hz' (1 pulso de 1 ciclo a cada segundo)
    -- 'cnt' conta de 0 ate CLK_FREQ-1 e reinicia, marcando 1 segundo.
    -- -------------------------------------------------------------------------
    process(clk, reset_n)
        variable cnt : integer range 0 to CLK_FREQ - 1;
    begin
        if reset_n = '0' then
            cnt := 0;
            tick_1hz <= '0';
        elsif rising_edge(clk) then
            if cnt = CLK_FREQ - 1 then
                cnt := 0;
                tick_1hz <= '1';
            else
                cnt := cnt + 1;
                tick_1hz <= '0';
            end if;
        end if;
    end process;

    -- -------------------------------------------------------------------------
    -- Contador regressivo:
    --   * reset assincrono (KEY[0] = '0') -> carrega o preset selecionado
    --   * decrementa 1 a cada pulso de 1 Hz, desde que nao esteja pausado
    --   * para em 0 (nao decrementa abaixo de zero)
    -- -------------------------------------------------------------------------
    process(clk, reset_n)
    begin
        if reset_n = '0' then
            seconds <= preset;
        elsif rising_edge(clk) then
            if pause_n = '1' and tick_1hz = '1' and seconds > 0 then
                seconds <= seconds - 1;
            end if;
        end if;
    end process;

    -- LED 'done' acende quando o timer chega a zero
    led_done <= '1' when seconds = 0 else '0';

    -- -------------------------------------------------------------------------
    -- Pipeline de display: integer -> BCD -> 4 SSDs
    -- Tudo combinacional. As 3 funcoes do package fazem o trabalho.
    -- -------------------------------------------------------------------------
    bcd_val <= int_to_bcd(seconds);
    ssd     <= bcd_to_ssds(bcd_val);

    -- Atribui o sinal interno (tipo definido pelo usuario) aos pinos
    -- individuais. Mesmo padrao da Atividade 6.
    hex0 <= ssd(0);
    hex1 <= ssd(1);
    hex2 <= ssd(2);
    hex3 <= ssd(3);

end architecture atividade7_arch;