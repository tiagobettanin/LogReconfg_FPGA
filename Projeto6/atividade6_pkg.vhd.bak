-------------------------------------------------------------------------------
-- atividade6_pkg.vhd
-- Atividade 6 - Lógica Reconfigurável - UTFPR Apucarana
-- Package contendo o tipo definido pelo usuário (array de std_logic_vector)
-- e o procedure que detecta o valor mínimo e o valor máximo.
-------------------------------------------------------------------------------
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

package atividade6_pkg is

    -- Tipo array de std_logic_vector (irrestrito - dimensões definidas no uso)
    -- O símbolo <> indica que o range é irrestrito (será fixado na instanciação)
    type slv_array is array (natural range <>) of std_logic_vector;

    -- Procedure que recebe um vetor de std_logic_vector e devolve dois sinais:
    -- min_val (menor valor) e max_val (maior valor). A procedure foi escolhida
    -- justamente porque precisamos devolver mais de um resultado.
    procedure find_min_max (
        signal x       : in  slv_array;
        signal min_val : out std_logic_vector;
        signal max_val : out std_logic_vector
    );

end package atividade6_pkg;

-------------------------------------------------------------------------------
-- Corpo do package: implementação do procedure
-------------------------------------------------------------------------------
package body atividade6_pkg is

    procedure find_min_max (
        signal x       : in  slv_array;
        signal min_val : out std_logic_vector;
        signal max_val : out std_logic_vector
    ) is
        -- Variáveis temporárias com a mesma largura das saídas
        variable temp_min : std_logic_vector(min_val'range);
        variable temp_max : std_logic_vector(max_val'range);
    begin
        -- Inicializa min e max com o primeiro elemento do vetor
        temp_min := x(x'low);
        temp_max := x(x'low);

        -- Varre os elementos restantes, atualizando min/max
        -- Comparações usam o cast para unsigned (std_logic_vector
        -- não tem operadores '<' e '>' com semântica numérica)
        for i in x'low + 1 to x'high loop
            if unsigned(x(i)) < unsigned(temp_min) then
                temp_min := x(i);
            end if;
            if unsigned(x(i)) > unsigned(temp_max) then
                temp_max := x(i);
            end if;
        end loop;

        -- Atribui os resultados às saídas do procedure
        min_val <= temp_min;
        max_val <= temp_max;
    end procedure find_min_max;

end package body atividade6_pkg;